[Unit]
Description=Sakhi FastAPI Backend
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/sakhi

EnvironmentFile=/home/ec2-user/sakhi/.env

ExecStart=/home/ec2-user/sakhi/.venv/bin/uvicorn src.backend.main:app \
    --host 0.0.0.0 \
    --port 8000

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
