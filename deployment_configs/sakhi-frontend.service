[Unit]
Description=Sakhi Streamlit Frontend
After=network.target

[Service]
User=ec2-user
Group=ec2-user

WorkingDirectory=/home/ec2-user/sakhi

EnvironmentFile=/home/ec2-user/sakhi/.env

ExecStart=/home/ec2-user/sakhi/.venv/bin/streamlit run src/frontend/app.py \
    --server.address=0.0.0.0 \
    --server.port=8501

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
